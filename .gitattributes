# Text files are stored with LF and checked out with the platform's line endings.
* text=auto

# Windows scripts keep CRLF.
*.bat text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.ttf binary
*.docx binary
*.zip binary

# Generated by pixi: no diffs in reviews, counted as generated on GitHub.
pixi.lock -diff linguist-generated=true
